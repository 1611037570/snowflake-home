{
  // 强制当前项目中所有文件默认使用 LF 换行符
  "files.eol": "\n",
  // 可选：禁止自动检测换行符（避免 VS Code 自动切换为 CRLF）
  "files.autoGuessEncoding": false,
  // 指定文件编码为 UTF-8
  "files.encoding": "utf8",
  // 允许 JSON 文件使用注释
  "files.associations": {
    "*.json": "jsonc"
  },
  // 关闭文件夹自动折叠（紧凑文件夹）功能
  "explorer.compactFolders": false,
}
