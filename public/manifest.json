{
  "manifest_version": 3,
  "name": "Vue3+Vite Chrome插件示例",
  "version": "1.0.0",
  "description": "基于Vue3+Vite改造的Chrome插件",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vue Chrome插件"
  },
  "icons": {
    "16": "favicon.ico",
    "48": "favicon.ico",
    "128": "favicon.ico"
  },
  "chrome_settings_overrides": {
    "homepage": "index.html",
    "newtab": "index.html"
  }
}
