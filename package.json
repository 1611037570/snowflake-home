{
  "name": "snowflake",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter=@snowflake/web --filter=@snowflake/server run dev",
    "dev:web": "pnpm --filter @snowflake/web dev",
    "dev:server": "pnpm --filter @snowflake/server dev",
    "i:web": "pnpm --filter @snowflake/web install",
    "i:server": "pnpm --filter '@snowflake/server' install"
  }
}