# 生产环境变量

# 应用部署基础路径
# VITE_BASE_URL = ./

# 初始入口路由，同时决定默认页面信息；起始页使用 /home，简历使用 /resume
VITE_DEFAULT_ROUTE = /resume

# 路由模式
VITE_ROUTER_MODE = history

# 默认语言
VITE_DEFAULT_LANGUAGE = zh-CN

# 接口基础路径
VITE_API_BASE_URL = http://nannan.work:3000

# 雪花服务器接口路径
VITE_SNOWFLAKE_API_URL = http://nannan.work:3000
