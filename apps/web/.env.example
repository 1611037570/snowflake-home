# 环境变量模板：只保留变量名，值为空；实际值写入不入库的分环境文件 .env.{运行模式}

# ===== 应用基础 =====
# 版本号
VITE_VERSION =
# 开发端口
VITE_PORT =
# 应用部署基础路径
VITE_BASE_URL =
# 站点对外绝对地址，用于拼接 og 卡片与站点地图，必须与后端 PUBLIC_SITE_URL 保持一致
VITE_SITE_URL =

# ===== 入口与语言 =====
# 初始入口路由，同时决定默认页面信息；起始页使用 /home，简历使用 /resume
VITE_DEFAULT_ROUTE =
# 路由模式
VITE_ROUTER_MODE =
# 默认语言
VITE_DEFAULT_LANGUAGE =

# ===== 接口与密钥 =====
# 雪花服务器接口路径
VITE_SNOWFLAKE_API_URL =
# 前端内置模型密钥
VITE_AI_API_KEY =