# 环境变量模板：敏感项复制到 .env.local，非敏感项复制到 .env.development / .env.production
# 加载优先级（先加载者优先）：系统/pm2 环境变量 > .env.local（不入库） > .env.{运行环境}（入库）

# 主数据库密码
DB_MAIN_PASSWORD=
# 简历库连接参数（简历库与基础库相互独立，全部写入 .env.local，不入库）
# 简历数据库主机
DB_RESUME_HOST=
# 简历数据库端口
DB_RESUME_PORT=3306
# 简历数据库用户名
DB_RESUME_USERNAME=
# 简历数据库密码
DB_RESUME_PASSWORD=
# 简历数据库名称
DB_RESUME_DATABASE=
# 缓存密码
REDIS_PASSWORD=
# 文档数据库密码
MONGODB_PASSWORD=
# 登录凭证签名密钥
JWT_SECRET=
# 人工智能上游密钥
OPENAI_API_KEY=
# 人工智能上游完整地址
OPENAI_BASE_URL=
# 人工智能上游模型（必填，缺失会启动报错）
OPENAI_MODEL=
# 站点对外访问根地址，本地填前端开发地址，生产填站点域名，不要以 / 结尾（必填，缺失会启动报错）
PUBLIC_SITE_URL=
# 打印页面地址，留空则由站点根地址拼接 /resume/print，需要指向其它地址时才填
PDF_RENDER_URL=
# 打印页面渲染超时，单位毫秒
PDF_RENDER_TIMEOUT=60000
# 天气上游基地址
WEATHER_BASE_URL=
# 天气上游应用标识
WEATHER_APP_ID=
# 天气上游应用密钥
WEATHER_APP_SECRET=
# 热榜上游基地址
HOT_LIST_BASE_URL=
# 热榜支持的分类，逗号分隔
HOT_LIST_CATEGORIES=douyin,zhihu,weibo,baidu,toutiao
# 搜索上游基地址
SEARCH_BASE_URL=
# 开源仓库全名，用于查询星标
GITHUB_REPOSITORY=1611037570/snowflake-home
# 仓库星标缓存有效期，单位毫秒
GITHUB_STARS_CACHE_TTL=1800000
# 第三方上游超时，单位毫秒
INTEGRATIONS_TIMEOUT=5000
