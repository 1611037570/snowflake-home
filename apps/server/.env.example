# 环境变量模板：只保留变量名，值为空；实际值写入不入库的分环境文件 .env.{运行环境}
# 加载优先级：系统/pm2 环境变量 > .env.{运行环境}（分环境，不入库）

# ===== 数据库 =====
# 主数据库密码
DB_MAIN_PASSWORD=
# 简历数据库主机
DB_RESUME_HOST=
# 简历数据库端口
DB_RESUME_PORT=
# 简历数据库用户名
DB_RESUME_USERNAME=
# 简历数据库密码
DB_RESUME_PASSWORD=
# 简历数据库名称
DB_RESUME_DATABASE=

# ===== 缓存与文档数据库 =====
# 缓存密码
REDIS_PASSWORD=
# 文档数据库密码
MONGODB_PASSWORD=

# ===== 登录凭证 =====
# 登录凭证签名密钥
JWT_SECRET=

# ===== 人工智能上游 =====
# 上游密钥
OPENAI_API_KEY=
# 上游完整地址
OPENAI_BASE_URL=
# 上游模型（必填，缺失会启动报错）
OPENAI_MODEL=

# ===== 站点与打印 =====
# 站点对外访问根地址，本地填前端开发地址，生产填站点域名，不要以 / 结尾（必填，缺失会启动报错）
PUBLIC_SITE_URL=
# 打印页面地址，留空则由站点根地址拼接 /resume/print，需要指向其它地址时才填
PDF_RENDER_URL=
# 打印页面渲染超时，单位毫秒
PDF_RENDER_TIMEOUT=

# ===== 第三方集成 =====
# 天气上游基地址
WEATHER_BASE_URL=
# 天气上游应用标识
WEATHER_APP_ID=
# 天气上游应用密钥
WEATHER_APP_SECRET=
# 热榜上游基地址
HOT_LIST_BASE_URL=
# 热榜支持的分类，逗号分隔
HOT_LIST_CATEGORIES=
# 搜索上游基地址
SEARCH_BASE_URL=
# 第三方上游超时，单位毫秒
INTEGRATIONS_TIMEOUT=

# ===== 开源仓库 =====
# 开源仓库全名，用于查询星标
GITHUB_REPOSITORY=
# 仓库星标缓存有效期，单位毫秒
GITHUB_STARS_CACHE_TTL=